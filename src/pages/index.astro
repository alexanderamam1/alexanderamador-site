---
import { getCollection } from 'astro:content';

const allDecisions = await getCollection('decisions');
const decisions = allDecisions
  .filter(d => !d.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alexander Amador — Analytics decisions</title>
    <meta name="description" content="A log of decisions made in data and analytics work. Each entry is one call: the problem, the trade-offs, what I did, and what I learned." />
    <meta property="og:title" content="Alexander Amador — Analytics decisions" />
    <meta property="og:description" content="A log of decisions made in data and analytics work. Each entry is one call: the problem, the trade-offs, what I did, and what I learned." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://alexanderamador-site.vercel.app" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <header>
        <p class="site-name">Alexander Amador</p>
        <p class="tagline">Analytics work, documented as decisions.</p>
      </header>

      <p class="intro">
        This is a log of decisions I've made in data and analytics work, not a portfolio of artifacts.
        Each entry is one call: the problem, the trade-offs, what I did, and what I learned.
        The work is the thinking.
      </p>

      <ul class="decision-list">
        {decisions.map(d => (
          <li>
            <a href={`/decisions/${d.data.slug}`}>
              <p class="decision-title">{d.data.title}</p>
              <p class="decision-teaser">{d.data.dek}</p>
              <p class="decision-meta">{d.data.tag} · {new Date(d.data.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short' })}</p>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <footer>
      <a href="mailto:hello.alex.amador@hotmail.com">hello.alex.amador@hotmail.com</a> ·
      <a href="https://linkedin.com/in/afav" target="_blank">LinkedIn</a>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Crimson Pro', Georgia, serif;
    background-color: #0a0a0a;
    color-scheme: dark;
    color: #e8e0d0;
    padding: 2rem 1rem;
    min-height: 100vh;
    background-image: radial-gradient(circle, #2a2a2a 1px, transparent 1px);
    background-size: 24px 24px;
  }

  main {
    max-width: 560px;
    margin: 0 auto;
    animation: fadeIn 0.6s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .site-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: #e8e0d0;
    margin-bottom: 0.3rem;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: 15px;
    font-style: italic;
    color: #8a8070;
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .intro {
    font-size: 17px;
    line-height: 1.75;
    color: #c8bfad;
    margin-bottom: 3rem;
  }

  .decision-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .decision-list a {
    text-decoration: none;
    color: inherit;
    display: block;
    padding-left: 0;
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
  }

  .decision-list a:hover {
    opacity: 1;
    padding-left: 0.75rem;
    border-left: 2px solid #c8a96e;
    cursor: pointer;
  }

  .decision-title {
    font-size: 19px;
    font-weight: 500;
    line-height: 1.35;
    color: #e8e0d0;
    margin-bottom: 8px;
  }

  .decision-teaser {
    font-size: 15px;
    line-height: 1.65;
    color: #8a8070;
    margin-bottom: 10px;
  }

  .decision-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #c8a96e;
  }

  footer {
    max-width: 560px;
    margin: 4rem auto 0;
    padding-top: 1.5rem;
    border-top: 0.5px solid #2a2a2a;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #8a8070;
    letter-spacing: 0.03em;
  }

  footer a {
    color: inherit;
    text-decoration: none;
  }

  footer a:hover {
    color: #c8a96e;
  }
</style>