---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const decisions = await getCollection('decisions');
  return decisions.map(d => ({
    params: { slug: d.data.slug },
    props: { decision: d },
  }));
}

const { decision } = Astro.props;
const { Content } = await render(decision);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{decision.data.title} — Alexander Amador</title>
    <meta name="description" content={decision.data.dek} />
    <meta property="og:title" content={decision.data.title} />
    <meta property="og:description" content={decision.data.dek} />
    <meta property="og:type" content="article" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <a href="/" class="back-link">← All decisions</a>
      <p class="meta">{decision.data.tag} · {new Date(decision.data.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short' })}</p>
      <h1>{decision.data.title}</h1>
      <p class="dek">{decision.data.dek}</p>
      <div class="body-content">
        <Content />
      </div>
      {decision.data.artifact_url && (
        <div class="artifact-callout">
          See the work: <a href={decision.data.artifact_url} target="_blank">{decision.data.artifact_label ?? 'artifact'}</a>
        </div>
      )}
    </main>
    <footer>
      <a href="mailto:hello.alex.amador@hotmail.com">hello.alex.amador@hotmail.com</a> ·
      <a href="https://linkedin.com/in/afav" target="_blank">LinkedIn</a>
    </footer>
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Iowan Old Style', 'Source Serif Pro', Cambria, Georgia, serif;
    background-color: #ffffff;
    color-scheme: light;
    color: #111;
    padding: 2rem 1rem;
  }
  main { max-width: 560px; margin: 0 auto; }
  .back-link {
    display: inline-block;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 13px;
    color: #999;
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .back-link:hover { color: #111; }
  .meta {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 1rem;
  }
  h1 { font-size: 26px; font-weight: 500; line-height: 1.25; color: #111; margin-bottom: 1rem; }
  .dek { font-size: 17px; font-style: italic; color: #555; line-height: 1.55; margin-bottom: 2.5rem; }
  .body-content h2 {
    font-size: 15px;
    font-weight: 500;
    font-family: 'Iowan Old Style', 'Source Serif Pro', Cambria, Georgia, serif;
    color: #111;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .body-content p { font-size: 16px; line-height: 1.75; color: #111; margin-bottom: 1.1rem; }
  .artifact-callout {
    margin-top: 3rem;
    background: #f7f7f5;
    border-radius: 8px;
    padding: 1rem;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    color: #555;
  }
  .artifact-callout a { color: #2563eb; }
  footer {
    max-width: 560px;
    margin: 4rem auto 0;
    padding-top: 1.5rem;
    border-top: 0.5px solid #ddd;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 13px;
    color: #555;
  }
  footer a { color: inherit; text-decoration: none; }
  footer a:hover { color: #111; }
</style>
