---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const decisions = await getCollection('decisions');
  return decisions.map(d => ({
    params: { slug: d.data.slug },
    props: { decision: d },
  }));
}

const { decision } = Astro.props;
const { Content } = await render(decision);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{decision.data.title} — Alexander Amador</title>
    <meta name="description" content={decision.data.dek} />
    <meta property="og:title" content={decision.data.title} />
    <meta property="og:description" content={decision.data.dek} />
    <meta property="og:type" content="article" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <a href="/" class="back-link">← All decisions</a>
      <p class="meta">{decision.data.tag} · {new Date(decision.data.date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short' })}</p>
      <h1>{decision.data.title}</h1>
      <p class="dek">{decision.data.dek}</p>
      <div class="body-content">
        <Content />
      </div>
      {decision.data.artifact_url && (
        <div class="artifact-callout">
          See the work: <a href={decision.data.artifact_url} target="_blank">{decision.data.artifact_label ?? 'artifact'}</a>
        </div>
      )}
    </main>
    <footer>
      <a href="mailto:hello.alex.amador@hotmail.com">hello.alex.amador@hotmail.com</a> ·
      <a href="https://linkedin.com/in/afav" target="_blank">LinkedIn</a>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Crimson Pro', Georgia, serif;
    background-color: #0a0a0a;
    color-scheme: dark;
    color: #e8e0d0;
    padding: 2rem 1rem;
    min-height: 100vh;
    background-image: radial-gradient(circle, #2a2a2a 1px, transparent 1px);
    background-size: 24px 24px;
  }

  main {
    max-width: 560px;
    margin: 0 auto;
    animation: fadeIn 0.6s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .back-link {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #8a8070;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }

  .back-link:hover { color: #c8a96e; }

  .meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #c8a96e;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.25;
    color: #e8e0d0;
    margin-bottom: 1rem;
  }

  .dek {
    font-size: 17px;
    font-style: italic;
    color: #8a8070;
    line-height: 1.55;
    margin-bottom: 2.5rem;
  }

  .body-content h2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #c8a96e;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .body-content p {
    font-size: 17px;
    line-height: 1.8;
    color: #c8bfad;
    margin-bottom: 1.1rem;
  }

  .artifact-callout {
    margin-top: 3rem;
    background: #111;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #8a8070;
  }

  .artifact-callout a {
    color: #c8a96e;
    text-decoration: none;
  }

  .artifact-callout a:hover {
    text-decoration: underline;
  }

  footer {
    max-width: 560px;
    margin: 4rem auto 0;
    padding-top: 1.5rem;
    border-top: 0.5px solid #2a2a2a;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #8a8070;
    letter-spacing: 0.03em;
  }

  footer a {
    color: inherit;
    text-decoration: none;
  }

  footer a:hover { color: #c8a96e; }
</style>
